{
  "name": "omni-index-addon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Addon de Stremio que agrega seis APIs publicas de indices de torrents y scene releases",
  "license": "MIT",
  "main": "src/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test tests/*.test.js",
    "lint": "node --check src/index.js && node --check src/server.js && node --check src/stream.js && node --check src/router.js && node --check src/worker.js",
    "worker:dev": "npx --yes wrangler@4 dev",
    "worker:deploy": "npx --yes wrangler@4 deploy",
    "worker:check": "npx --yes wrangler@4 deploy --dry-run --outdir .wrangler/dist",
    "worker:tail": "npx --yes wrangler@4 tail",
    "beamup:deploy": "beamup deploy",
    "beamup:logs": "beamup logs"
  },
  "devDependencies": {
    "stremio-addon-linter": "1.7.0"
  }
}
