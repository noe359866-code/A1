<?xml version="1.0" encoding="utf-8"?>
<!--
    Omni TV · manifiesto SOLO para Android TV.
    - leanback obligatorio → solo aparece en televisores / Google TV.
    - touchscreen opcional → el mando (D-pad) es el input principal.
    - banner 320×180 obligatorio para el launcher de TV.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Solo Android TV / Google TV -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <!-- El mando D-pad sustituye a la pantalla táctil -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
        Copias de seguridad: se permiten, pero los ajustes del panel de
        vinculación (código, URLs de addons, claves de API) quedan excluidos
        (res/xml/backup_rules.xml y data_extraction_rules.xml).

        usesCleartextTraffic: el puente de streams y los addons caseros se
        sirven por http:// en la red local, y network_security_config no
        admite rangos de IP. El límite «http solo en la LAN» lo impone
        data/NetPolicy.kt sobre cada URL de addon y cada enlace de vídeo.
    -->
    <application
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OmniTV"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.OmniTV"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Solo aparece en el launcher de Android TV -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
