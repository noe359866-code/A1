<?xml version="1.0" encoding="utf-8"?>
<!-- Banner para el launcher de Android TV (referencia 320×180) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <!-- Fondo degradado oscuro -->
    <path android:pathData="M0,0 L320,0 L320,180 L0,180 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="320"
                android:endY="180"
                android:type="linear">
                <item android:offset="0" android:color="#FF101018" />
                <item android:offset="1" android:color="#FF0B0B0F" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Aro de lupa violeta -->
    <path
        android:pathData="M126,88 m-34,0 a34,34 0 1,0 68,0 a34,34 0 1,0 -68,0"
        android:strokeColor="#FF7C5CFF"
        android:strokeWidth="7"
        android:fillColor="#00000000" />
    <path
        android:pathData="M150,112 L172,134"
        android:strokeColor="#FF7C5CFF"
        android:strokeWidth="9"
        android:strokeLineCap="round" />

    <!-- Seis puntos turquesa dentro de la lupa -->
    <path android:pathData="M112,80 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" android:fillColor="#FF00C2A8" />
    <path android:pathData="M126,74 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" android:fillColor="#FF00C2A8" />
    <path android:pathData="M140,80 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" android:fillColor="#FF00C2A8" />
    <path android:pathData="M112,96 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" android:fillColor="#FF00C2A8" />
    <path android:pathData="M126,102 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" android:fillColor="#FF00C2A8" />
    <path android:pathData="M140,96 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" android:fillColor="#FF00C2A8" />

    <!-- Tipografía "Omni TV" simulada con barras -->
    <path android:pathData="M198,72 h8 v36 h-8 z" android:fillColor="#FFFFFFFF" />
    <path android:pathData="M212,72 h20 a10,10 0 0,1 0,20 h-20 v-8 h18 a2,2 0 0,0 0,-4 h-18 z" android:fillColor="#FFFFFFFF" />
