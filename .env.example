# Copia este fichero a .env y ajusta según necesites (ninguna variable es obligatoria).
# Para Cloudflare Workers usa en su lugar [vars] / secrets de wrangler.toml o
# .dev.vars (ver .dev.vars.example y docs/CLOUDFLARE.md): los nombres OMNI_*
# son los mismos en ambos runtimes, salvo PORT y HOST.
PORT=7000
HOST=0.0.0.0

# URL pública del addon. Si está vacía se deduce de Host / X-Forwarded-*.
# Ponla en Beamup si el proxy no reenvía el Host real: así `logo` y `background`
# del manifiesto apuntan al dominio público y no a una IP interna.
# En Cloudflare normalmente no hace falta: request.url ya es la URL pública.
# OMNI_PUBLIC_URL=https://<hash>-omniindex.baby-beamup.club

# Configuración por defecto del manifiesto raíz (JSON en una línea)
# OMNI_CONFIG={"maxStreams":30,"cacheTtl":900,"enableCatalog":false}

# Clave opcional para los filtros de texto de predataba.se
# OMNI_PREDATABA_KEY=

# Transporte
# OMNI_HTTP_TIMEOUT=9000
# OMNI_USER_AGENT=OmniIndexStremioAddon/1.0
# OMNI_QUIET=1

# Bases alternativas (proxies / servidores propios / tests)
# OMNI_KNABEN_BASE=https://api.knaben.org
# OMNI_TORRENTS_CSV_BASE=https://torrents-csv.com
# OMNI_TORLOCK_BASE=https://www.torlock.com
# OMNI_PREDB_NET_BASE=https://api.predb.net
# OMNI_PREDATABA_SE_BASE=https://predataba.se
# OMNI_XREL_BASE=https://api.xrel.to
# OMNI_CINEMETA_BASE=https://v3-cinemeta.strem.io
